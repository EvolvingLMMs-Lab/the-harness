{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "window",
  "description": "The window's own title bar and embedded native browser controller: only the main webview on this computer's localhost host may drag/resize the window or control the sandboxed browser child webview",
  "local": true,
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "webviews": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "allow-browser-open",
    "allow-browser-bounds",
    "allow-browser-nav",
    "allow-browser-close"
  ]
}
