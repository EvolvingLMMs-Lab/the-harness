{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Harness",
  "mainBinaryName": "the-harness",
  "version": "0.0.0",
  "identifier": "com.lmms-lab.harness",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "appimage", "deb"],
    "publisher": "The Harness contributors",
    "copyright": "Copyright (c) 2026 The Harness contributors",
    "license": "MIT",
    "homepage": "https://harness.lmms-lab.com",
    "category": "Productivity",
    "shortDescription": "The Harness: a resident agent for this computer",
    "longDescription": "The Harness desktop app: the agent's chats, calendar and settings in a window, a tray icon that keeps it running, and its own Python runtime.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/harness": "linux/harness"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/EvolvingLMMs-Lab/the-harness/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
