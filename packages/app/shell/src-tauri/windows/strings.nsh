; The Harness: the texts of our installer pages (ui.nsh), in English and Simplified Chinese.
; Windows picks the language from the system; English is the fallback.

Caption "$(H_Caption)"
UninstallCaption "$(H_UnCaption)"

; Fonts: the archive fonts for English; Chinese text in Microsoft YaHei UI.
LangString H_FaceTitle ${LANG_ENGLISH} "Space Grotesk Medium"
LangString H_FaceTitle ${LANG_SIMPCHINESE} "Microsoft YaHei UI"
LangString H_FaceBody ${LANG_ENGLISH} "Inter"
LangString H_FaceBody ${LANG_SIMPCHINESE} "Microsoft YaHei UI"
LangString H_FaceMono ${LANG_ENGLISH} "JetBrains Mono"
LangString H_FaceMono ${LANG_SIMPCHINESE} "Microsoft YaHei UI"
LangString H_FaceButton ${LANG_ENGLISH} "Inter SemiBold"
LangString H_FaceButton ${LANG_SIMPCHINESE} "Microsoft YaHei UI"
LangString H_WeightButton ${LANG_ENGLISH} "400"
LangString H_WeightButton ${LANG_SIMPCHINESE} "700"

LangString H_Caption ${LANG_ENGLISH} "Install ${PRODUCTNAME}"
LangString H_Caption ${LANG_SIMPCHINESE} "安装 ${PRODUCTNAME}"
LangString H_UnCaption ${LANG_ENGLISH} "Remove ${PRODUCTNAME}"
LangString H_UnCaption ${LANG_SIMPCHINESE} "卸载 ${PRODUCTNAME}"

LangString H_Step1 ${LANG_ENGLISH} "Welcome"
LangString H_Step1 ${LANG_SIMPCHINESE} "欢迎"
LangString H_Step2 ${LANG_ENGLISH} "Location"
LangString H_Step2 ${LANG_SIMPCHINESE} "位置"
LangString H_Step3 ${LANG_ENGLISH} "Install"
LangString H_Step3 ${LANG_SIMPCHINESE} "安装"
LangString H_Step4 ${LANG_ENGLISH} "Finish"
LangString H_Step4 ${LANG_SIMPCHINESE} "完成"

LangString H_Part1 ${LANG_ENGLISH} "Python runtime ${H_PYVER} (bundled)"
LangString H_Part1 ${LANG_SIMPCHINESE} "Python 运行时 ${H_PYVER}（自带）"
LangString H_Part2 ${LANG_ENGLISH} "${PRODUCTNAME} ${VERSION}"
LangString H_Part2 ${LANG_SIMPCHINESE} "${PRODUCTNAME} ${VERSION}"
LangString H_Part3 ${LANG_ENGLISH} "Shell (Tauri)"
LangString H_Part3 ${LANG_SIMPCHINESE} "外壳（Tauri）"

LangString H_Next ${LANG_ENGLISH} "Next"
LangString H_Next ${LANG_SIMPCHINESE} "下一步"
LangString H_Back ${LANG_ENGLISH} "Back"
LangString H_Back ${LANG_SIMPCHINESE} "上一步"
LangString H_Cancel ${LANG_ENGLISH} "Cancel"
LangString H_Cancel ${LANG_SIMPCHINESE} "取消"
LangString H_Install ${LANG_ENGLISH} "Install"
LangString H_Install ${LANG_SIMPCHINESE} "安装"
LangString H_Browse ${LANG_ENGLISH} "Browse…"
LangString H_Browse ${LANG_SIMPCHINESE} "浏览…"
LangString H_Open ${LANG_ENGLISH} "Open ${PRODUCTNAME}"
LangString H_Open ${LANG_SIMPCHINESE} "打开 ${PRODUCTNAME}"
LangString H_Close ${LANG_ENGLISH} "Close"
LangString H_Close ${LANG_SIMPCHINESE} "关闭"

LangString H_WelcomeTitle ${LANG_ENGLISH} "Welcome to ${PRODUCTNAME}"
LangString H_WelcomeTitle ${LANG_SIMPCHINESE} "欢迎使用 ${PRODUCTNAME}"
LangString H_WelcomeText ${LANG_ENGLISH} "${PRODUCTNAME} is an agent that stays on this computer and works for you. This installer sets up the three parts below; nothing else needs installing first."
LangString H_WelcomeText ${LANG_SIMPCHINESE} "${PRODUCTNAME} 是常驻在这台电脑上、替你做事的智能体。安装包会装好下面三部分，不需要先装别的。"
LangString H_ForYou ${LANG_ENGLISH} "For this user only · no administrator rights needed"
LangString H_ForYou ${LANG_SIMPCHINESE} "只为当前用户安装 · 不需要管理员权限"

LangString H_LocationTitle ${LANG_ENGLISH} "Where to install"
LangString H_LocationTitle ${LANG_SIMPCHINESE} "装在哪里"
LangString H_LocationText ${LANG_ENGLISH} "Choose a folder. ${PRODUCTNAME} installs for you only, so any folder you can write to works."
LangString H_LocationText ${LANG_SIMPCHINESE} "选一个文件夹。${PRODUCTNAME} 只为你自己安装，你能写入的文件夹都可以。"
LangString H_BrowseTitle ${LANG_ENGLISH} "Choose a folder for ${PRODUCTNAME}"
LangString H_BrowseTitle ${LANG_SIMPCHINESE} "选择安装 ${PRODUCTNAME} 的文件夹"
LangString H_Space ${LANG_ENGLISH} "Needs about ${H_MB} MB"
LangString H_Space ${LANG_SIMPCHINESE} "需要约 ${H_MB} MB"

LangString H_InstallTitle ${LANG_ENGLISH} "Installing"
LangString H_InstallTitle ${LANG_SIMPCHINESE} "正在安装"
LangString H_Installing ${LANG_ENGLISH} "Installing…"
LangString H_Installing ${LANG_SIMPCHINESE} "安装中…"
LangString H_Unsigned ${LANG_ENGLISH} "The installer is not signed yet, so Windows may say “unknown publisher” when you open it. The getting-started guide shows each step."
LangString H_Unsigned ${LANG_SIMPCHINESE} "安装包暂未签名：Windows 打开它时可能提示“未知发布者”。上手指南里有每一步的截图。"

LangString H_FinishTitle ${LANG_ENGLISH} "Installed"
LangString H_FinishTitle ${LANG_SIMPCHINESE} "装好了"
LangString H_Autostart ${LANG_ENGLISH} "Keep working after the computer starts"
LangString H_Autostart ${LANG_SIMPCHINESE} "开机后继续工作"
LangString H_AutostartNote ${LANG_ENGLISH} "${PRODUCTNAME} starts when you sign in. Settings › General changes this."
LangString H_AutostartNote ${LANG_SIMPCHINESE} "登录后 ${PRODUCTNAME} 自动启动，设置的“通用”里能改。"
LangString H_Done ${LANG_ENGLISH} "installed"
LangString H_Done ${LANG_SIMPCHINESE} "装好了"
LangString H_DoneLogin ${LANG_ENGLISH} "installed · starts at login"
LangString H_DoneLogin ${LANG_SIMPCHINESE} "装好了 · 开机后启动"
