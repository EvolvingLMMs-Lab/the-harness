# Workers static asset headers, copied to dist/_headers by `deno task build`.
# Each page carries its own Content-Security-Policy meta tag: Astro's under /docs/,
# tools/registry.ts's under /packages/.
#
# A path that matches several rules gets the headers of all of them, and a header set
# twice is joined with a comma, so rules that set the same header must not overlap.
/docs/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/docs/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/packages/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The package registry, written by `deno task registry`. index.json is the only file
# that changes; everything under <name>/<version>/ is published once and never edited.
/registry/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
  Access-Control-Allow-Origin: *

/registry/index.json
  Cache-Control: public, max-age=300

/registry/:name/*
  Cache-Control: public, max-age=31536000, immutable
