---
const { siteTitle, lang } = Astro.locals.starlightRoute;
const home = lang.startsWith("zh") ? "/zh-cn/" : "/";
---
<div class="docs-brand">
  <a href="https://www.lmms-lab.com/" class="lab-mark" aria-label="LMMS Lab home"><img src={`${import.meta.env.BASE_URL}/lmms-logo.png`} alt="LMMS Lab" width="128" height="44" /></a>
  <a href={home} class="site-title" translate="no">{siteTitle}</a>
</div>
<!-- The lab logo's load animation, served from the site root with the homepage's files. -->
<script is:inline src="/logo-motion.js?v=1" defer></script>
<style>
.docs-brand{display:flex;align-items:center;gap:1rem;min-width:0}
.lab-mark{display:flex;flex:none;align-items:center}
.lab-mark img{width:116px;height:auto;object-fit:contain}
.site-title{white-space:nowrap;color:var(--sl-color-white);text-decoration:none;font-size:.95rem;font-weight:600;line-height:1.3}
@media(max-width:30rem){.lab-mark img{width:90px}.docs-brand{gap:.65rem}.site-title{font-size:.85rem}}
</style>
