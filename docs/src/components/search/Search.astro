---
// The Simulator documentation's search: the dialog shell is eager, and Pagefind's UI,
// styles and index load only when it opens (controller.ts).
import { Icon } from "@astrojs/starlight/components";
import stylesheet from "@pagefind/default-ui/css/ui.css?url";

const zh = Astro.locals.starlightRoute.lang.startsWith("zh");
const translations = {
  placeholder: Astro.locals.t("search.label"),
  // Supply this locale explicitly: the default UI can fall back to English for
  // zh-CN even though Pagefind selects the Chinese search index.
  ...(zh
    ? {
        clear_search: "清除",
        load_more: "加载更多结果",
        search_label: "搜索文档",
        filters_label: "筛选",
        zero_results: "没有找到“[SEARCH_TERM]”的结果",
        many_results: "找到 [COUNT] 条关于“[SEARCH_TERM]”的结果",
        one_result: "找到 [COUNT] 条关于“[SEARCH_TERM]”的结果",
        alt_search: "没有找到“[SEARCH_TERM]”。显示“[DIFFERENT_TERM]”的结果",
        search_suggestion: "没有找到“[SEARCH_TERM]”。试试以下搜索：",
        searching: "正在搜索“[SEARCH_TERM]”…",
      }
    : {}),
  ...Object.fromEntries(
    Object.entries(Astro.locals.t.all())
      .filter(([key]) => key.startsWith("pagefind."))
      .map(([key, value]) => [key.replace("pagefind.", ""), value]),
  ),
};
---

<docs-search
  class={Astro.props.class}
  data-translations={JSON.stringify(translations)}
  data-base={import.meta.env.BASE_URL}
  data-stylesheet={stylesheet}
  data-dev={import.meta.env.DEV || undefined}
>
  <button data-open-modal disabled aria-label={Astro.locals.t("search.label")} aria-haspopup="dialog">
    <Icon name="magnifier" />
    <span class="sl-hidden md:sl-block">{Astro.locals.t("search.label")}</span>
    <kbd class="sl-hidden md:sl-block" hidden></kbd>
  </button>
  <dialog aria-label={Astro.locals.t("search.label")}>
    <div class="search-frame">
      <button class="search-close" data-close-modal>{Astro.locals.t("search.cancelLabel")}</button>
      <p data-loading role="status">
        {import.meta.env.DEV ? Astro.locals.t("search.devWarning") : zh ? "正在加载搜索…" : "Loading search…"}
      </p>
      <div data-error hidden>
        <p role="alert">{zh ? "搜索未能加载，请刷新页面后重试。" : "Search could not load. Reload the page to try again."}</p>
        <button data-reload>{zh ? "刷新页面" : "Reload page"}</button>
      </div>
      <div id="docs-search-results"></div>
    </div>
  </dialog>
</docs-search>

<script>
  import "./controller.ts";
</script>

<style>
  docs-search { display: contents; }
  button { cursor: pointer; font: inherit; }
  [data-open-modal] {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    padding: 0.5rem;
    color: var(--sl-color-gray-2);
  }
  kbd {
    margin-inline-start: auto;
    padding-inline: 0.375rem;
    font: inherit;
    font-size: var(--sl-text-xs);
    background: var(--sl-color-gray-6);
  }
  dialog {
    padding: 0;
    width: calc(100% - 2rem);
    max-width: 40rem;
    max-height: calc(100% - 2rem);
    margin: 1rem auto auto;
    border: 1px solid var(--doc-line);
    border-radius: var(--doc-radius);
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    box-shadow: var(--doc-surface-shadow);
  }
  dialog::backdrop { background: var(--sl-color-backdrop-overlay); }
  .search-frame { padding: 1rem; min-height: 12rem; }
  .search-close {
    display: block;
    margin-inline-start: auto;
    margin-block-end: 0.75rem;
    padding: 0.25rem 0.5rem;
    border: 0;
    background: transparent;
    color: inherit;
  }
  [data-loading] { white-space: pre-line; }
  [data-reload] {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: var(--doc-radius-control);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  #docs-search-results {
    --pagefind-ui-primary: var(--sl-color-white);
    --pagefind-ui-text: var(--sl-color-gray-2);
    --pagefind-ui-background: var(--sl-color-black);
    --pagefind-ui-border: var(--sl-color-gray-5);
    --pagefind-ui-tag: var(--sl-color-gray-6);
    --pagefind-ui-font: var(--__sl-font);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 9px;
  }
  @media (min-width: 50rem) {
    [data-open-modal] { width: 100%; max-width: 22rem; padding-inline: 0.75rem; }
    dialog { margin-block-start: 4rem; max-height: calc(100% - 8rem); }
    .search-frame { padding: 1.5rem; }
  }
</style>

<style is:global>
  /* Keep the default UI in the documentation's monochrome theme. */
  #docs-search-results .pagefind-ui__search-input {
    color: var(--sl-color-white);
    font-weight: 400;
  }
  docs-search :is(button, input, a):focus-visible {
    outline: 2px solid var(--sl-color-white);
    outline-offset: 2px;
  }
  #docs-search-results mark {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    border-radius: 3px;
    padding-inline: 0.125em;
  }
  #docs-search-results .pagefind-ui__result-link {
    font-weight: 500;
  }
  body[data-search-modal-open] { overflow: hidden; }
  docs-search [hidden] { display: none !important; }
</style>
