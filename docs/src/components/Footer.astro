---
import config from "virtual:starlight/user-config";
import Default from "@astrojs/starlight/components/Footer.astro";

const links = [...(config.social ?? [])].sort((a, b) => Number(b.icon === "github") - Number(a.icon === "github"));
---

<Default />

<nav class="ar-footer-links docs-social" aria-label="LMMs-Lab">
  {links.map(({ label, href }) => <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>)}
</nav>

<div class="ar-page-crt" aria-hidden="true"></div>

<!--
  This direct browser script intentionally uses JavaScript: it annotates the
  rendered navigation before Astro's deferred prefetch initializer runs.
  inlineCspHashes includes it in the production page's script policy.
-->
<script is:inline>
  for (const link of document.querySelectorAll("#starlight__sidebar a[href], .pagination-links a[href]")) {
    const url = new URL(link.href, location.href);
    if (url.origin === location.origin && url.pathname.startsWith("/docs/") &&
        !link.hasAttribute("download") && (!link.target || link.target === "_self")) {
      link.dataset.astroPrefetch = "hover";
    }
  }
</script>
