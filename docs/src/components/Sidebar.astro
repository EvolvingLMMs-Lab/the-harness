---
// The header is the lab banner and names no product, so the name and the way back to the
// homepage sit at the top of the sidebar, on the desktop rail and in the phone menu.
import Default from "@astrojs/starlight/components/Sidebar.astro";

const home = Astro.locals.starlightRoute.lang.startsWith("zh") ? "/zh-cn/" : "/";
---

<a class="docs-home" href={home} translate="no">The Harness</a>
<Default />

<style>
  .docs-home {
    color: var(--sl-color-white);
    font: 500 1rem / 1.3 var(--ar-body);
    text-decoration: none;
  }
  .docs-home:hover {
    color: var(--sl-color-accent);
  }
</style>
