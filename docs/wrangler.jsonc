{
  // Static documentation Worker for harness.lmms-lab.com, the whole host (a Custom
  // Domain): the pages live under /docs as on The Simulator's site, and _redirects
  // sends the bare domain there.
  "name": "harness-docs",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "harness.lmms-lab.com", "custom_domain": true }
  ]
}
